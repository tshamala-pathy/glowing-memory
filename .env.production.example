# Production environment — copy to `.env` before `docker compose -f docker-compose.prod.yml up`.
# Never commit `.env`.

# --- Django core (required) ---
SECRET_KEY=replace-with-a-long-random-secret-from-python-secrets-token-urlsafe-64
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# HTTPS behind nginx / load balancer
USE_TLS=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Public site URL (scheme + host, no trailing slash)
FRONTEND_URL=https://yourdomain.com
PROJECT_BASE_URL=https://yourdomain.com

CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database (docker-compose.prod sets DB_HOST=db) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pathycode
DB_USER=pathycode
DB_PASSWORD=change-this-strong-db-password

# --- Branding ---
BRAND_NAME=PathyCode
COMPANY_TAGLINE=Business & financial operations
# FINANCIAL_DASHBOARD_ALLOWED_EMAILS=owner@yourdomain.com

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# --- PayFast (production merchant credentials) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX_URL=https://www.payfast.co.za/eng/process
PAYFAST_RETURN_URL=https://yourdomain.com/payments/success/
PAYFAST_CANCEL_URL=https://yourdomain.com/payments/cancel/
PAYFAST_NOTIFY_URL=https://yourdomain.com/payments/notify/

# --- Optional build/runtime tuning ---
# REACT_APP_BACKEND_URL=https://yourdomain.com
# HTTP_PORT=80
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
# LOG_LEVEL=INFO
