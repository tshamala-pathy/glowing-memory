# Python cache files
__pycache__/
*.py[cod]

# Environment variables / secrets (never commit)
.env
.env.*
!.env.example
!.env.production.example

# Virtual environment folder
venv/
ENV/
env/
.venv/

# Django database file (if using SQLite)
db.sqlite3

# Django static files (collected static folder)
staticfiles/
static/

# Media files (user uploaded content)
media/

# PyCharm IDE files
.idea/

# VSCode IDE files
.vscode/

# Node / frontend
node_modules/
frontend/node_modules/
frontend/build/
**/node_modules/.cache/
*.eslintcache

# Logs
*.log

# macOS system files
.DS_Store

# Windows system files
Thumbs.db

# Coverage reports
.coverage
htmlcov/

# Migrations: we commit them so deployments can run migrate (uncomment to ignore)
# */migrations/

# Byte-compiled / optimized / DLL files
*.so

# Test result files
.pytest_cache/

# mypy type checker
.mypy_cache/
.dmypy.json
dmypy.json
# Pyre type checker
.pyre/
# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
